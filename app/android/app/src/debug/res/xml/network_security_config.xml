<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config.

  Permits cleartext (plain HTTP/gRPC) traffic to the local Firebase Emulator
  Suite only. The Android emulator reaches the developer's host machine at the
  special alias 10.0.2.2; localhost/127.0.0.1 are included for completeness.

  This file lives under src/debug/, so it is compiled into debug builds only.
  Release builds never include it and therefore keep Android's default policy
  (cleartext blocked on API 28+). See app/lib/main.dart -> USE_FIRESTORE_EMULATOR.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
