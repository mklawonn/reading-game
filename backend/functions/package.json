{
  "name": "reading-game-functions",
  "description": "Cloud Functions for Reading Game — the Story Builder Claude proxy.",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
