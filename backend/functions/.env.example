# Cloud Functions configuration — NAMES ONLY. Never commit real secrets.
#
# The Anthropic API key is stored as a Firebase secret, not here:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# (documented for discoverability):
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by storyBuilder.
# Default is claude-opus-4-8 (most capable). For lower cost/latency at scale you may switch to:
#   STORY_MODEL=claude-sonnet-4-6
STORY_MODEL=claude-opus-4-8
